{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Portfolio.WebApi/Portfolio.WebApi.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Saytni ishga tushirish",
      "type": "shell",
      "command": "${workspaceFolder}/Ishga-tushirish.bat",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Testlar",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/Portfolio.Tests"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
